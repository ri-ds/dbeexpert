# ---------------------------------------------------------------------------
# DBE Faculty Expertise Explorer
#
# Copy to .env and fill in the values. Never commit the real .env.
#
#   cp .env.example .env
#
# Every secret below is REQUIRED. Compose fails immediately and names the missing
# variable rather than starting with a placeholder password, which is deliberate:
# a silent fallback to a well known password on a hosted server is worse than a
# failed deploy.
# ---------------------------------------------------------------------------

# ---- Hosting ----
# Where the app is served from. "/" for a root deployment, or a sub path with
# leading and trailing slashes for a reverse proxy mount.
#
#   BASE_PATH=/expert/     ->  http://host/expert/  and  http://host/expert/api/
#   BASE_PATH=/            ->  http://host/         and  http://host/api/
#
# This is a BUILD argument, not a runtime one: Vite bakes it into every asset URL
# and exposes it to the app as import.meta.env.BASE_URL. Changing it requires
# `docker compose up -d --build`, which the normal deploy already does.
BASE_PATH=/

# Interface the frontend and backend ports bind to on the host. Keep this at
# 127.0.0.1 when a reverse proxy sits in front, so the containers are not
# reachable from the network directly. Use 0.0.0.0 only for local development
# where you want to hit them from another device.
BIND_HOST=127.0.0.1

# Host ports the reverse proxy points at. Nothing else is published: Neo4j and
# Postgres have no host binding at all.
FRONTEND_PORT=8080
BACKEND_PORT=8011

# Browser origins allowed to call the API cross origin. In the hosted setup the
# API is same origin, since nginx serves the app and /expert/api/ from one host,
# so this is not exercised there. It matters for local Vite dev and any non
# browser caller.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Sign in ----
# Header the SSO proxy uses to tell the app who the user is. The CCHMC
# service provider sends sso-uid, sso-email, sso-fname and sso-lname, all of
# which are recognised automatically, so this rarely needs setting.
AUTH_USER_HEADER=X-Forwarded-User

# Where the Sign out button sends the user. Leave EMPTY and the button is
# hidden, which is the default, because a logout link that 404s is worse
# than none. Ask IT for the correct service provider logout URL: none of the
# usual SimpleSAMLphp paths exist on accessrimd, they all returned 404.
# Note that SAML single logout is often left disabled deliberately, since it
# can sign the user out of every other application too.
AUTH_LOGOUT_URL=

# ---- OpenAI (required) ----
OPENAI_API_KEY=sk-proj-replace-me
OPENAI_CHAT_MODEL=gpt-5-mini
# Naming conversations uses a separate cheap non reasoning model on purpose. See
# the README for why a reasoning model costs more here despite the token cap.
OPENAI_TITLE_MODEL=gpt-4o
# MUST match the model that wrote the vectors in the graph. The dump was built
# with text-embedding-ada-002, so anything else silently degrades every answer.
#
# Do not change this to text-embedding-3-small. It is also 1536 dimensions, so the
# width check below still passes, but it is a different embedding space: measured
# on this graph, top cosine similarity drops from 0.92 to 0.52 and the faculty
# returned for a question change completely. Changing it safely requires
# re-embedding all 8,375 Chunk nodes.
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
# Width of the stored vectors. Checked at startup. Note that a matching width does
# NOT mean a matching model, which is exactly how the mismatch above hides.
OPENAI_EMBEDDING_DIMENSIONS=1536

# ---- Neo4j (required) ----
# Set a real password before hosting. Neo4j is not published to the host, so it
# is only reachable from the backend over the compose network, but a strong value
# still matters.
NEO4J_PASSWORD=replace-me
NEO4J_IMAGE_TAG=2026.06-enterprise
# The supplied dump uses the block storage format, which Neo4j Community cannot
# read, so an Enterprise image is required. "eval" accepts the 30 day
# evaluation licence. Change to "yes" once you hold a commercial or academic
# licence. See the README for how to convert the dump for Community instead.
NEO4J_ACCEPT_LICENSE_AGREEMENT=eval
NEO4J_HEAP=2G
NEO4J_PAGECACHE=1G

# ---- Feedback storage, Postgres (required) ----
# Kept separate from Neo4j on purpose: the graph is rebuilt by loading a dump,
# and user submitted feedback must never live somewhere a restore overwrites.
POSTGRES_DB=dbefeedback
POSTGRES_USER=dbe
POSTGRES_PASSWORD=replace-me

# Temporary shared password for the /admin feedback view. This is a placeholder
# until CCHMC SSO is added, at which point the admin view should be gated on a
# group claim and this should be deleted.
ADMIN_PASSWORD=replace-me

# ---- Pipeline tuning ----
# How many OpenAI calls may be in flight at once.
PIPELINE_MAX_CONCURRENCY=10
# How many chunks each retrieval pass pulls back.
RETRIEVAL_TOP_K=100
# Ceiling on how many faculty get an LLM relevance judgement per open ended
# question. This is the main cost and latency control.
MAX_JUDGED_FACULTY=24
LLM_REQUEST_TIMEOUT=120
# Server side ceiling on a generated Cypher transaction.
CYPHER_TIMEOUT_SECONDS=30
SESSION_TTL_SECONDS=21600
