# Copy to .env and fill in. Or set these as real environment variables.
OPENAI_API_KEY=
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password4
# Optional path overrides (defaults point at the bundled folders):
# ONTOLOGY_DIR=/absolute/path/to/ontology
# NAMES_CSV=/absolute/path/to/names.csv
